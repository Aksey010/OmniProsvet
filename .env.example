# Whisper
WHISPER_MODEL=small
LANGUAGE=auto
WHISPER_FAST=1
WHISPER_BATCH_SIZE=8

# Диаризация (polyvoice — модели качаются автоматически, токен не нужен)
DIARIZATION=1
POLYVOICE_VARIANT=balanced

# NVIDIA NIM API (бесплатный ключ с https://build.nvidia.com)
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_REDUCE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_RPM=120
NIM_MAX_TOKENS=8192
NIM_TEMPERATURE=0.7
NIM_FREQUENCY_PENALTY=0.4
NIM_PRESENCE_PENALTY=0.3
NIM_WORKERS=16
NIM_IMAGES_PER_BATCH=3
NIM_CHUNK_CHAR_BUDGET=8000

# Обработка
CHUNK_CHAR_BUDGET=65000
CHUNK_MAX_LINES=300
IMAGES_PER_BATCH=25
PDF_MAX_SIZE_MB=40

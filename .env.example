# Whisper
WHISPER_MODEL=small
LANGUAGE=auto
WHISPER_FAST=1
WHISPER_BATCH_SIZE=8
# int8 — для CPU; float16 — заметно быстрее на GPU
WHISPER_COMPUTE_TYPE=int8
# Параллельные файлы транскрибации (CPU-bound; > числа физических ядер смысла нет)
WHISPER_WORKERS=4
# Устройство транскрибации: auto (cuda при наличии GPU, иначе cpu) | cuda | cpu.
# На GPU int8 автоматически повышается до float16; на одной карте WHISPER_WORKERS=1..2
WHISPER_DEVICE=auto

# Диаризация (polyvoice — модели качаются автоматически, токен не нужен)
DIARIZATION=1
POLYVOICE_VARIANT=balanced

# NVIDIA NIM API (бесплатный ключ с https://build.nvidia.com)
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_REDUCE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_RPM=120
# gpt-oss-20b на NIM имеет контекст 32768 токенов: вывод+вход должны вместе
# влезть в него. 8192 + автопродолжение покрывает конспекты; больше max_tokens
# = меньше места для входа (крупные батчи документов начнут падать с 400).
NIM_MAX_TOKENS=8192
NIM_TEMPERATURE=0.7
NIM_FREQUENCY_PENALTY=0.4
NIM_PRESENCE_PENALTY=0.3
NIM_WORKERS=16
# Сколько картинок отправлять в ОДНОМ vision-запросе. Проверьте лимит модели:
# meta/llama-3.2-90b-vision-instruct принимает ровно 1 (иначе HTTP 400
# «At most 1 image(s) may be provided»).
NIM_IMAGES_PER_BATCH=1
NIM_CHUNK_CHAR_BUDGET=8000
# Лимит извлечённого текста документов на один запрос (символы) —
# должен влезать в контекст модели вместе с max_tokens.
NIM_DOC_TEXT_CHARS=60000
# Автопродолжение ответа при обрыве по max_tokens (finish_reason=length); 0 = off
NIM_MAX_CONTINUATIONS=3
# Иерархический reduce: фрагментов больше этого числа -> промежуточные
# групповые сводки (параллельно) -> компактный финальный reduce; 0 = off
NIM_REDUCE_GROUP_SIZE=24
# Read-таймаут HTTP-запроса к NIM (секунды). Ответы приходят за секунды;
# зависший запрос дешевле перезапустить (5 ретраев), чем ждать минуты.
NIM_READ_TIMEOUT=180
# Размер пула соединений httpx: должен вмещать одновременные запросы всех
# параллельных фаз (PDF/таблицы/презентации/картинки). Меньше — потоки ждут
# свободный слот и падают с PoolTimeout (потерянные файлы при живом сервере).
NIM_MAX_CONNECTIONS=64
# Картинки тяжелее этого (байт) ужимаются перед отправкой в Vision (2048px,
# JPEG q85): большие фото приводили к ReadTimeout на vision-модели.
NIM_IMAGE_MAX_BYTES=3000000

# Чанкинг
CHUNK_CHAR_BUDGET=65000
CHUNK_MAX_LINES=300
IMAGES_PER_BATCH=25
PDF_MAX_SIZE_MB=40

# Пропуск файлов по подстрокам имени (через запятую, регистр не важен).
# По умолчанию выбрасываются стикеры Telegram: N_sticker.webm/.webp и
# N_animation.gif.mp4 — речи и содержания в них нет, а обработка (транскрибация
# + vision) тратила часы. Пустое значение отключает фильтр. Документы
# (pdf/docx/…) фильтр не трогает.
SKIP_FILE_PATTERNS=sticker,animation.gif
